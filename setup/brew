#!/usr/bin/env zsh

source "$(dirname "$0")/util.sh"
source "$(dirname "$0")/spinner.zsh"

brewfile=$1

if [ -z "${brewfile:-}" ]; then
  fail "No brewfile specified"
  exit 1
fi

if [ ! -f "$brewfile" ]; then
  fail "$brewfile" "not found"
  exit 1
fi

failures=0

# Let Homebrew parse the Brewfile so we stay compatible with `brew bundle`
# while keeping our own concise, spinner-based output.
bundle_list() {
  brew bundle list --file="$brewfile" "$1" 2>/dev/null
}

# Exact, whole-line matching. Substring matching would wrongly treat
# "tree-sitter" as installed when only "tree-sitter-cli" is present.
is_installed() {
  printf '%s\n' "$2" | grep -Fxq -- "$1"
}

title "Brew Setup"

installed_taps=$(brew tap 2>/dev/null)

start_spinner "Tapping" "started…"
while IFS= read -r tap; do
  [ -z "$tap" ] && continue
  if is_installed "$tap" "$installed_taps"; then
    continue
  fi
  update_spinner "Tapping" "${tap}…"
  if ! output=$(brew tap "$tap" 2>&1); then
    stop_spinner
    fail "$tap" "failed to tap"
    quote "$output"
    failures=$((failures + 1))
    start_spinner "Tapping" "continuing…"
  fi
done <<EOF
$(bundle_list --taps)
EOF
stop_spinner
success "Tapped" "taps"

title "Install Formulas"

installed_formulas=$(brew list --formula -1 2>/dev/null)

while IFS= read -r formula; do
  [ -z "$formula" ] && continue
  if is_installed "$formula" "$installed_formulas"; then
    skip "$formula" "already installed, skipping"
    continue
  fi

  start_spinner "$formula" "installing…"
  if output=$(brew install --formula "$formula" 2>&1); then
    stop_spinner
    success "$formula" "installed"
  else
    stop_spinner
    fail "$formula" "failed to install"
    quote "$output"
    failures=$((failures + 1))
  fi
done <<EOF
$(bundle_list --formulae)
EOF

title "Install Casks"

installed_casks=$(brew list --cask -1 2>/dev/null)

while IFS= read -r cask; do
  [ -z "$cask" ] && continue
  if is_installed "$cask" "$installed_casks"; then
    skip "$cask" "already installed, skipping"
    continue
  fi

  start_spinner "$cask" "installing…"
  if output=$(brew install --cask "$cask" 2>&1); then
    stop_spinner
    success "$cask" "installed"
  else
    stop_spinner
    fail "$cask" "failed to install"
    quote "$output"
    failures=$((failures + 1))
  fi
done <<EOF
$(bundle_list --casks)
EOF

title "Clean up"

start_spinner "Formulas and casks" "installed, cleaning up…"
brew cleanup >/dev/null 2>&1
stop_spinner
success "Brew cleaned up"

if [ "$failures" -gt 0 ]; then
  fail "Brew setup" "$failures package(s) failed to install"
  exit 1
fi
